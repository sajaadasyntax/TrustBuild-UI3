# Public Google measurement configuration
# Use GTM_ID when the Ads manager wants Google Tag Manager to own GA4 and Ads tags.
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXXX

# Use this instead of GTM_ID for direct GA4 loading.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Required for direct Google Ads conversion reporting from the website.
# When GTM is used, the same job_posted dataLayer event can be used in a GTM conversion tag.
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_ID=AW-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=XXXXXXXXXXXXXXX
